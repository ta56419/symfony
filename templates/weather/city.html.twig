{% extends 'base.html.twig' %}

{# @var location \App\Entity\Location #}
{# @var measurements \App\Entity\Measurement[] #}

{% block title %}Weather in {{ location.city }}, {{ location.country }}{% endblock %}

{% block body %}
    <style>
        .example-wrapper { margin: 1em auto; max-width: 800px; width: 95%; font: 18px/1.5 sans-serif; }
        .example-wrapper code { background: #F5F5F5; padding: 2px 6px; }
    </style>

    <div class="example-wrapper">
        <h1>Weather in {{ location.city }}, {{ location.country }}</h1>

        <ul>
            {% for measurement in measurements %}
                <li>
                    {{ measurement.date|date('d.m.Y') }}: {{ measurement.celsius }}&deg;C —
                    {{ measurement.condition }},
                    wilgotność: {{ measurement.humidity }}%,
                    ciśnienie: {{ measurement.pressure }} hPa
                </li>
            {% endfor %}
        </ul>
    </div>
{% endblock %}
